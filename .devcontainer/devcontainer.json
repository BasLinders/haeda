{
  // Python 3.13: every pinned package in requirements.txt ships prebuilt
  // wheels for it. On 3.14 numpy/pandas/scikit-learn/statsmodels/matplotlib
  // compile from source, which made codespace setup take very long.
  "name": "haeda",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13",
  "postCreateCommand": "pip install --prefer-binary -r requirements-dev.txt",
  "forwardPorts": [8501],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
